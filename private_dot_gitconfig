[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = Clay Jensen-Reimann
	email = clayreimann@gmail.com
	signingkey = ~/.ssh/id_ed25519_sign.pub
[init]
	defaultBranch = main
[alias]
	st = status -sb
	ca = commit -a
	coam = commit --amend
	caam = commit -a --amend
	undo = reset HEAD^
	diff-stash = stash show -p
	force = push --force
	save = commit -am 'checkpoint'
	cb = "!f() { git checkout -b `echo \"$@\" | sed -E 's/ /-/g'`; }; f"
	put = "!git stash -u && git push --tags -u origin `git branch --show-current` && git stash pop"
	put-fork = "!git stash -u && git push --tags -u clayreimann `git branch --show-current` && git stash pop"

[core]
	excludesfile = ~/.gitignore_global

[diff]
	renames = copies

[pull]
	ff = only
[push]
	followTags = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /usr/bin/ssh-keygen
	allowedSignersFile = /Users/clay/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
