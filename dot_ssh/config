# Machine-local hosts, not committed. Must precede `Host *` — OpenSSH takes
# the first obtained value for each option, so an include placed later could
# not override anything. A missing file is silently skipped.
Include ~/.ssh/config.local

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  IdentityAgent "~/.1password/agent.sock"

Host pm02.4406.madtown.cloud
  IdentityFile ~/.ssh/pm02_ided

Host github.com
  IdentityAgent "~/.1password/agent.sock"
